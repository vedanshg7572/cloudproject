# CloudGuard AI - Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ─── AWS Core ─────────────────────────────────────────────
# Option A: Use IAM Role (recommended for Lambda/EC2 — no keys needed)
# Option B: Use Access Keys for local dev

AWS_REGION=us-east-1
# AWS_ACCESS_KEY_ID=your-access-key-id-here
# AWS_SECRET_ACCESS_KEY=your-secret-access-key-here

# ─── Amazon Bedrock (AI Copilot) ──────────────────────────
# Enable to use real AI — falls back to demo responses if not set
BEDROCK_ENABLED=false
BEDROCK_REGION=us-east-1
BEDROCK_MODEL_ID=anthropic.claude-3-haiku-20240307-v1:0

# ─── App Config ───────────────────────────────────────────
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# ─── Demo Mode ────────────────────────────────────────────
# Set to true to always use demo data (no AWS calls)
DEMO_MODE=true
